{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ckngfrlnsqwqxhxtiwkt.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "ai-style-lab",
      "version": "0.1.0",
      "title": "AI Style Lab"
    },
    "tools": [
      {
        "name": "list_closet_items",
        "title": "List closet items",
        "description": "List the signed-in user's saved clothing items, newest first. Optionally filter by category.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "enum": [
                "topwear",
                "bottomwear",
                "outerwear",
                "footwear",
                "accessory"
              ],
              "description": "Only return items in this category."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "description": "Maximum items to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_closet_item",
        "title": "Add closet item",
        "description": "Save a clothing item to the signed-in user's virtual closet.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Product name."
            },
            "brand": {
              "type": "string",
              "description": "Brand name."
            },
            "category": {
              "type": "string",
              "enum": [
                "topwear",
                "bottomwear",
                "outerwear",
                "footwear",
                "accessory"
              ],
              "description": "Clothing category."
            },
            "price": {
              "type": "string",
              "description": "Price with currency symbol, e.g. \"$49\"."
            },
            "image_url": {
              "type": "string",
              "format": "uri",
              "description": "Product image URL."
            },
            "product_url": {
              "type": "string",
              "format": "uri",
              "description": "Retailer product page URL."
            },
            "selected_color": {
              "type": "string",
              "description": "Chosen color."
            },
            "selected_size": {
              "type": "string",
              "description": "Chosen size, e.g. \"M\"."
            }
          },
          "required": [
            "name",
            "category"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_outfits",
        "title": "List outfits",
        "description": "List the signed-in user's saved outfits with their layered clothing items.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Maximum outfits to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_outfit",
        "title": "Create outfit",
        "description": "Create a named outfit for the signed-in user from existing closet item ids, layered in the given order.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Outfit name."
            },
            "clothing_item_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "minItems": 1,
              "maxItems": 12,
              "description": "Closet item ids, ordered from innermost to outermost layer."
            }
          },
          "required": [
            "name",
            "clothing_item_ids"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_measurements",
        "title": "Get body measurements",
        "description": "Get the signed-in user's profile: display name, country, fit preference, and body measurements used for fit scoring.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_try_ons",
        "title": "List virtual try-ons",
        "description": "List the signed-in user's saved virtual try-on images, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Maximum try-ons to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
